# === Core ===
PIPELINE_DATA_DIR=output
# Optional per-pipeline default params. Edit config/pipeline.defaults.yaml and set enabled: true.
PIPELINE_DEFAULTS_FILE=config/pipeline.defaults.yaml

# === Web / ZeroTier access ===
# Safe default: loopback only. For ZeroTier, use the exact interface IP; never use 0.0.0.0.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
WEB_ALLOWED_NETWORKS=
WEB_ALLOWED_HOSTS=127.0.0.1,localhost,::1
WEB_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
WEB_AUTH_REQUIRED=false
# Required before remote access. Generate independent random values; do not commit them.
WEB_ADMIN_TOKEN=
WEB_API_TOKEN=
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=604800
# Web/API publishing is independently disabled even when a task says publish=true.
WEB_PUBLISH_ENABLED=false
WEB_PUBLISH_REAUTH_SECONDS=300
# Preferred remote transport. Configure both files together.
# WEB_TLS_CERTFILE=G:\path\to\zerotier.crt
# WEB_TLS_KEYFILE=G:\path\to\zerotier.key
# Explicit restricted-mode exception when relying on ZeroTier transport encryption without HTTPS.
WEB_ALLOW_ZEROTIER_HTTP=false

# === Gemini ===
GEMINI_SKILL_DIR=G:\Job\gemini-skill
# Optional command template for image generation.
# The command must write ordered image files to {output_dir} and may use {prompt}, {topic}, {count}.
# Example: python path\to\generate_images.py --prompt "{prompt}" --output "{output_dir}" --count {count}
GEMINI_IMAGE_COMMAND=

# === Photo-Process ===
PHOTO_PROCESS_DIR=G:\Job\Photo-Process
PHOTO_PROCESS_PYTHON=G:\Job\Photo-Process\.venv311\Scripts\python.exe
# Optional local persistent browser worker. Start Photo-Process Web UI/worker on this host before enabling.
# PHOTO_PROCESS_WORKER_URL=http://127.0.0.1:8000

# === MoneyPrinterTurbo ===
MPT_DIR=G:\Job\MoneyPrinterTurbo
MPT_PYTHON=G:\Job\MoneyPrinterTurbo\.venv\Scripts\python.exe
AI_ART_BGM_DIR=G:\Job\MoneyPrinterTurbo\resource\songs

# === social-auto-upload ===
SAU_DIR=G:\Job\social-auto-upload
SAU_EXE=G:\Job\social-auto-upload\.venv\Scripts\sau.exe
# Bilibili private upload support, verified against biliup-cli 1.2.1 on 2026-07-17.
# Keep this fail-closed value so every Bilibili upload is submitted as only-self.
SAU_BILIBILI_PRIVATE_ARGS=--is-only-self 1

# === Router LLM (optional) ===
# If absent, a deterministic keyword fallback is used.
ROUTER_LLM_BASE_URL=
ROUTER_LLM_API_KEY=
ROUTER_LLM_MODEL=

# === Publish Guards ===
# All publish defaults to OFF. Set publish: true in task JSON explicitly.
# Finance / AI Briefing source directories and read-only content research:
FINANCE_MD_DIR=G:\Job\Automation-Output\sajin\fund-daily
AI_BRIEFING_DIR=G:\Hermes-Output\每日AI简报
TTSKILL_COMMAND=ttskill
TTSKILL_TIMEOUT_SECONDS=120
