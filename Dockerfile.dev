FROM python:3.11-slim

WORKDIR /app

# Copy source before installing the src-layout package.
COPY pyproject.toml ./
COPY src ./src
COPY profiles ./profiles
COPY tests ./tests
COPY app.py ./

# Install deps with test tools.
RUN pip install --no-cache-dir ".[test,dev]"

ENV PIPELINE_DATA_DIR=/data

# Dev server with hot reload
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
